# Copie este arquivo para .env e preencha os valores reais.
# .env.example é só o modelo/catálogo.
# Variáveis com padrão podem ser omitidas no .env — nesse caso o app usa o padrão.

# ── Movidesk (obrigatório) ─────────────────────────────────────────
MOVIDESK_TOKEN=coloque_aqui_o_token
MOVIDESK_BASE_URL=https://api.movidesk.com/public/v1/tickets

# ── Sessão do login / área de gestão ───────────────────────────────
# Chave para assinar os cookies de sessão. Gere uma forte:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_forte_e_aleatoria
# Validade da sessão de login, em dias (evita relogar toda hora no celular). Padrão: 7.
SESSION_DAYS=7
# Validade (dias) do cookie de lembrança das TVs (papel "tv": re-login automatico apos reboot). Padrão: 3650.
TV_REMEMBER_DAYS=3650
# Marca o cookie como Secure (só trafega em HTTPS). Deixe false na intranet (http://);
# ligue (true) apenas ao publicar com HTTPS. Padrão: false.
SESSION_COOKIE_SECURE=false

# ── Dashboard ──────────────────────────────────────────────────────
# Liga o Dashboard 2 (gestão/performance). Padrão: false.
DASHBOARD2=false
# Tempo, s, de cache dos tickets no backend para reduzir chamadas ao Movidesk. Padrão: 30. Use 0 para desativar.
CACHE_TTL_SECONDS=30
# Ajustes finos do Dashboard 2 (opcionais; descomente para sobrescrever os padrões):
#   PERF_WINDOW_DAYS: janela dos números-âncora, em dias. Padrão: 30.
#   PERF_EVOLUCAO_DIAS: dias da série de evolução. Padrão: 14.
#   PERF_CACHE_TTL_SECONDS: TTL do cache do Dashboard 2, em s. Padrão: 300.
#PERF_WINDOW_DAYS=30
#PERF_EVOLUCAO_DIAS=14
#PERF_CACHE_TTL_SECONDS=300

# ── Servidor Flask ─────────────────────────────────────────────────
# Host e porta de escuta. Padrões: 0.0.0.0 e 7001.
FLASK_HOST=0.0.0.0
FLASK_PORT=7001
# Modo debug (auto-reload + debugger). Padrão: False. Use True APENAS em desenvolvimento.
FLASK_DEBUG=False

# ── Tokens de acesso por setor (capability URLs) ───────────────────
# Usado apenas pelo CLI `python -m core.tokens` para montar as URLs das TVs. Padrão:
# http://192.168.90.124
PUBLIC_BASE_URL=http://192.168.90.124

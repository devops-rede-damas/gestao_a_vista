# Copie este arquivo para .env e preencha com o token real.
# O arquivo .env NÃO é versionado (está no .gitignore).

MOVIDESK_TOKEN=coloque_aqui_o_token
MOVIDESK_BASE_URL=https://api.movidesk.com/public/v1/tickets

# Tempo, s, de cache dos tickets no backend para reduzir chamadas ao Movidesk. Padrão: 30. Use 0 para desativar.
CACHE_TTL_SECONDS=30

# Ativa o modo debug do Flask (auto-reload e debugger). Padrão: False. Use True APENAS em desenvolvimento.
FLASK_DEBUG=False

# Segredos — NUNCA versionar o token do Movidesk
.env

# Tokens de acesso por setor (capability URLs) — segredos, NUNCA versionar
config/tokens.json

# Usuários do painel de gestão (hashes de senha) — segredos, NUNCA versionar
